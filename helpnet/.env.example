
# ===================================================================
# AMBIENTE & APLICAÇÃO
# ===================================================================
VITE_APP_NAME="HELP-NET"
VITE_APP_ENV=production

# ===================================================================
# INTEGRAÇÃO COM BACKEND (SPRING BOOT - RAILWAY)
# ===================================================================
# URL base da API em produção
VITE_API_BASE_URL=https://help-net-backend-production.up.railway.app

# ===================================================================
# SEGURANÇA & AUTENTICAÇÃO
# ===================================================================
# Chave utilizada para salvar o Token JWT no LocalStorage do navegador
VITE_AUTH_TOKEN_KEY=@HelpNet:token

# ===================================================================
# UPLOAD DE ARQUIVOS (Sincronizado com MAX_FILE_SIZE do Backend)
# ===================================================================
# Limite máximo de anexo aceito pelos formulários (10MB em Bytes)
VITE_MAX_FILE_SIZE_BYTES=10485760